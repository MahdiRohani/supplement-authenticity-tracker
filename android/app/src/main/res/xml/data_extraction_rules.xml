<?xml version="1.0" encoding="utf-8"?><!--
   The consumer key and the scan device id are per-install by design: restoring
   them on another phone would merge two devices in clone detection.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="consumer_identity.xml" />
        <exclude domain="sharedpref" path="scan_context.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="consumer_identity.xml" />
        <exclude domain="sharedpref" path="scan_context.xml" />
    </device-transfer>
</data-extraction-rules>
